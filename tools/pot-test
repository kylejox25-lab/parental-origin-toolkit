#!/usr/bin/env python3
"""pot-test — binomial test of parental imbalance on a two-column count TSV.

Usage: pot-test -i FILE [OPTIONS]
  --col1 NAME --col2 NAME   count column names (default: genome1, genome2)
  --expected P              null probability of col1 (default: 0.5)
  -o FILE                   output TSV (default: stdout)

Appends p_value and q_value (Benjamini-Hochberg FDR) columns.
Works on pot-count output directly:
  pot-count -s S1 --regions regions.bed | pot-test
"""
import argparse
import csv
import os
import sys

sys.path.insert(0, os.path.join(os.path.dirname(os.path.abspath(__file__)), "lib"))
import pot_stats as ps


def main():
    ap = argparse.ArgumentParser(description="Binomial test of parental imbalance")
    ap.add_argument("-i", "--input", help="input TSV (default: stdin)")
    ap.add_argument("--col1", default="genome1")
    ap.add_argument("--col2", default="genome2")
    ap.add_argument("--expected", type=float, default=0.5)
    ap.add_argument("-o", "--output")
    args = ap.parse_args()

    fh = open(args.input) if args.input else sys.stdin
    try:
        reader = csv.DictReader(fh, delimiter="\t")
        fieldnames = reader.fieldnames or []
        if args.col1 not in fieldnames or args.col2 not in fieldnames:
            sys.exit(f"ERROR: columns '{args.col1}'/'{args.col2}' not found; "
                     f"available: {', '.join(fieldnames)}")
        rows = list(reader)
    finally:
        if args.input:
            fh.close()

    tested = []
    for r in rows:
        c1 = int(float(r[args.col1] or 0))
        c2 = int(float(r[args.col2] or 0))
        total = c1 + c2
        if total == 0:
            r["p_value"] = "1"
            r["q_value"] = "1"
            continue
        p = ps.binomial_pval(c1, total, args.expected)
        r["p_value"] = f"{p:.4g}"
        tested.append((id(r), p))
    qs = ps.bh_fdr(tested)
    for r in rows:
        if "q_value" not in r:
            r["q_value"] = f"{qs.get(id(r), 1.0):.4g}"

    out = open(args.output, "w", newline="") if args.output else sys.stdout
    try:
        writer = csv.DictWriter(out, fieldnames=fieldnames + ["p_value", "q_value"],
                                delimiter="\t", extrasaction="ignore")
        writer.writeheader()
        writer.writerows(rows)
    finally:
        if args.output:
            out.close()


if __name__ == "__main__":
    main()
